# ─────────────────────────────────────────────────────────────
# White-label branding — copy this file to `.env` and edit, then
# rebuild (`npm run build`). One `.env` per customer / per brand.
# Every value is optional; anything left blank uses the default.
# ─────────────────────────────────────────────────────────────

# API base URL (backend). Leave as /api when served behind the same host.
VITE_API_URL=/api

# ── Company / group (umbrella name on landing page + tab title) ──
VITE_BRAND_COMPANY=Sai Ram Group
VITE_BRAND_TAGLINE=Poultry Business Suite
VITE_BRAND_APP_TITLE=Sai Ram Feeds
# VITE_BRAND_FAVICON_URL=/logo.png

# ── Per-business display names ──
VITE_BRAND_FEEDS_NAME=Sai Ram Feeds
VITE_BRAND_CHICKEN_NAME=Sai Charan Chicken Center
VITE_BRAND_LAYER_NAME=Sai Ram Layer Farm

# ── Short names (compact nav back-links) ──
VITE_BRAND_FEEDS_SHORT=Feeds
VITE_BRAND_CHICKEN_SHORT=Chicken Center
VITE_BRAND_LAYER_SHORT=Layer Farm

# ── Logos (emoji by default; or a URL to an image) ──
VITE_BRAND_FEEDS_LOGO=🐔
VITE_BRAND_CHICKEN_LOGO=🛒
VITE_BRAND_LAYER_LOGO=🥚

# ── Document / bill header ──
VITE_BRAND_BILL_NAME=Sai Ram Feeds
VITE_BRAND_ADDRESS=Vill. Nagaram, Mdl. Lingalaghanpur, Dist. Jangaon - 506 167
VITE_BRAND_PHONE=
VITE_BRAND_EMAIL=
VITE_BRAND_GSTIN=

# ── Theme ──
# VITE_BRAND_PRIMARY_COLOR=#c0392b
