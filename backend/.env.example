# ─────────────────────────────────────────────────────────────
# Backend environment. Copy to `.env` and fill in for each
# deployment. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# Local development: set DEBUG=True (permissive CORS, dev SECRET_KEY ok).
# Production: leave DEBUG unset/False — SECRET_KEY then becomes REQUIRED.
DEBUG=False

# REQUIRED in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated hostnames this app is served on.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated front-end origins allowed to call the API (production).
# e.g. https://sairamfeeds.in,https://www.sairamfeeds.in
CORS_ALLOWED_ORIGINS=

# Postgres connection (if unset, falls back to local SQLite).
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Set True ONLY for a deliberate non-HTTPS internal deployment (disables
# SSL redirect, secure cookies, HSTS). Leave False for any public deploy.
DISABLE_HTTPS=False

# ── Error monitoring (Sentry) — optional; off when SENTRY_DSN is empty ──
# Create a Django project at sentry.io (free tier is fine) and paste its DSN.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=           # e.g. git SHA of the deployed build
# SENTRY_TRACES_SAMPLE_RATE=0   # 0.0-1.0; performance tracing, off by default
