# PoultryTrack backup settings — copied to /etc/poultrytrack/backup.env by
# deploy/install-backups.sh. Edit there, not here. (E9)

BACKUP_DIR=/root/backups
RETENTION_DAYS=30          # local copies older than this are deleted…
MIN_KEEP=7                 # …but the newest 7 are always kept

# Off-box copy (STRONGLY recommended — a backup on the same server dies with it).
# Configure a remote once with `rclone config` (OneDrive, Google Drive, B2, S3,
# DigitalOcean Spaces…), then set e.g.:
#   BACKUP_REMOTE=onedrive:PoultryTrack-Backups
BACKUP_REMOTE=
REMOTE_RETENTION_DAYS=90

# Alert if backups stop: create a free check at https://healthchecks.io
# (period 1 day, grace 2 hours) and paste its ping URL. It emails you when a
# backup fails OR simply doesn't run.
BACKUP_PING_URL=
BACKUP_VERIFY_PING_URL=

BACKUP_MEDIA=1             # also back up uploaded documents
